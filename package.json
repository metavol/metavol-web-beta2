{
  "name": "metavol-web",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "parity": "node scripts/parity-check.mjs",
    "check:ui-lang": "python scripts/check-ui-language.py",
    "check:affine": "node scripts/affine-check.mjs",
    "check:render": "node scripts/render-health.mjs",
    "check:mask": "node scripts/mask-roundtrip.mjs",
    "check:reg": "node scripts/reg-feasibility-check.mjs --case hirata2",
    "check": "npm run check:ui-lang && npx vue-tsc --noEmit && node scripts/affine-check.mjs",
    "check:modality": "node scripts/nifti-modality.mjs",
    "check:crop": "node scripts/ct-crop-check.mjs",
    "check:snapshot": "node scripts/snapshot-roundtrip.mjs",
    "check:d2n": "node scripts/dicom2nifti-check.mjs",
    "check:d2n-ui": "node scripts/d2n-ui-repro.mjs"
  },
  "dependencies": {
    "@mdi/font": "6.2.95",
    "@types/axios": "^0.14.0",
    "axios": "^1.7.2",
    "dcmjs-codecs": "^0.0.8",
    "dicom-parser": "^1.8.21",
    "jpeg-lossless-decoder-js": "^2.1.2",
    "jspdf": "^4.2.1",
    "nifti-reader-js": "^0.6.8",
    "pinia": "^3.0.4",
    "pptxgenjs": "^4.0.1",
    "roboto-fontface": "*",
    "three": "^0.164.1",
    "vue": "^3.4.21",
    "vuetify": "^3.5.8"
  },
  "devDependencies": {
    "@babel/types": "^7.24.0",
    "@types/node": "^20.11.25",
    "@vitejs/plugin-vue": "^5.0.4",
    "playwright": "^1.59.1",
    "sass": "^1.71.1",
    "typescript": "^5.4.2",
    "unplugin-fonts": "^1.1.1",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.1.5",
    "vite-plugin-vuetify": "^2.0.3",
    "vue-tsc": "^2.0.6"
  }
}
